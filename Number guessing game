#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int num;
    int no_of_guesses = 0;
    int guessed;
    srand(time(0));

    num = (rand() % 100) + 1;

  // printf("Random number: %d\n", num);//
   
   do{
    printf (" guess the number between 1 and 100: ");
    scanf("%d", &guessed);
    if(guessed>num){
        printf("Your guess is too high.\n");
    }
    else if(guessed<num){
        printf("Your guess is too low.\n");
    }
    no_of_guesses++;
   }
    while(guessed!= num);
    printf("You guessed the number in %d guesses.\n", no_of_guesses);
    return 0;
}
